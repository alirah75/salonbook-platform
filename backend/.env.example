# Set in your shell or a secret manager. Alembic does not auto-load .env files.
# Use a migration-owner account, never the application login.
DATABASE_MIGRATION_URL=
# Offline operator CLI only; never reuse this credential for SALONBOOK_DATABASE_URL.
# SALONBOOK_CONTROL_DATABASE_URL=

# Runtime reads SALONBOOK_* variables. Keep real credentials outside Git.
SALONBOOK_DATABASE_URL=
SALONBOOK_ENVIRONMENT=development
SALONBOOK_ALLOWED_HOSTS=["localhost","127.0.0.1"]
SALONBOOK_CORS_ORIGINS=[]
# Docs default to enabled in development and disabled in production.
# SALONBOOK_DOCS_ENABLED=false
SALONBOOK_LOG_LEVEL=INFO
# Required for auth; generate a Fernet-format signing key outside Git.
# Without a key, development exposes health routes but auth fails closed (503).
# Production requires this key.
# SALONBOOK_AUTH_KEY=
SALONBOOK_AUTH_SESSION_HOURS=24
SALONBOOK_AUTH_IDLE_MINUTES=120
SALONBOOK_AUTH_STAFF_SESSION_HOURS=8
SALONBOOK_AUTH_STAFF_IDLE_MINUTES=30
SALONBOOK_AUTH_ATTEMPT_LIMIT=10
SALONBOOK_AUTH_IP_LIMIT=50
SALONBOOK_AUTH_WINDOW_SECONDS=900
SALONBOOK_API_IP_LIMIT=240
SALONBOOK_API_WINDOW_SECONDS=60
# Explicitly enable the durable test gateway; never moves real money.
SALONBOOK_MOCK_PAYMENTS_ENABLED=false
# Appointment/payment mode is server-owned. Only a test provider exists in stage 9.
SALONBOOK_PAYMENTS_MODE=test
# SALONBOOK_AUTH_PUBLIC_PORT=8000
SALONBOOK_DB_POOL_SIZE=5
SALONBOOK_DB_MAX_OVERFLOW=5
SALONBOOK_DB_POOL_TIMEOUT_SECONDS=3
SALONBOOK_DB_POOL_RECYCLE_SECONDS=900
SALONBOOK_DB_CONNECT_TIMEOUT_SECONDS=3
SALONBOOK_DB_STATEMENT_TIMEOUT_MS=5000
SALONBOOK_DB_LOCK_TIMEOUT_MS=2000
SALONBOOK_DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
